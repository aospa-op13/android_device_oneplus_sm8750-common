<resources>

    <!-- Color of the UDFPS Pressed view -->
    <color name="config_udfpsColor">#ffffe6</color>

    <!-- StatusBar burn-in protection -->
    <bool name="config_statusBarBurnInProtection">true</bool>
    <integer name="config_shift_interval">40</integer>

    <!-- Max visible notification icons -->
    <integer name="config_maxVisibleNotificationIcons">6</integer>
    <integer name="config_maxVisibleNotificationIconsOnLock">7</integer>

    <!-- HBM type of UDFPS overlay.
         0 - GLOBAL HBM
         1 - LOCAL HBM
    -->
    <integer name="config_udfps_hbm_type">0</integer>

    <!-- The location of the devices physical tri state switch
         0: Left side
         1: Right side -->
    <integer name="config_alertSliderLocation">0</integer>

    <!-- Doze: does the single tap sensor need a proximity check? -->
    <bool name="doze_single_tap_proximity_check">true</bool>

    <!-- Doze: does the double tap sensor need a proximity check? -->
    <bool name="doze_double_tap_proximity_check">true</bool>

    <!-- Doze: does the pickup sensor need a proximity check? -->
    <bool name="doze_pickup_event_proximity_check">true</bool>

</resources>
