# Audio
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.spf_restart=true
ro.audio.asyncdump.support=1
ro.audio.monitorRotation=1

# Bluetooth
bluetooth.hardware.power.idle_cur_ma=4
bluetooth.hardware.power.operating_voltage_mv=4000
bluetooth.hardware.power.rx_cur_ma=18
bluetooth.hardware.power.tx_cur_ma=33
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.bap.broadcast.source.enabled=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.vcp.controller.enabled=true
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac
persist.sys.fflag.override.settings_bluetooth_hearing_aid=true
persist.vendor.bluetooth.3rd.lhdcv5.support=true
persist.vendor.bluetooth.leaudio_mode=ums-cg
persist.vendor.bluetooth.modem_nv_support=true
persist.vendor.bt.aac_frm_ctl.enabled=true
persist.vendor.bt.aac_vbr_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac-aptxadaptiver2
persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=true
persist.vendor.qcom.bluetooth.dualmode_transport_support=true
persist.vendor.qcom.bluetooth.fmd_config_info=80:0C:60:90:0F:00:00:14:01
persist.vendor.qcom.bluetooth.fmd_header=8:02:01:06:18:16:AA:FE:40
persist.vendor.qcom.bluetooth.lossless_aptx_adaptive_le.enabled=true
ro.bluetooth.a2dp_offload.supported=true

# Camera
ro.camera.enableCamera1MaxZsl=1
ro.camera.notify_nfc=1
ro.camerax.extensions.enabled=true
ro.hardware.camera=oemlayer
vendor.camera.aux.packageexcludelist=org.telegram.messenger,org.thunderdog.challegram,us.zoom.videomeetings

# DPM
persist.vendor.dpm.vndr.feature=11

# DRM
drm.service.enabled=true

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# Fuse
persist.sys.fuse.passthrough.enable=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Graphics
debug.sf.enable_advanced_sf_phase_offset=1
graphics.gpu.profiler.support=true

# Incremental FS
ro.incremental.enable=yes

# Keystore
ro.hardware.keystore_desede=true

# Media
debug.c2.use_dmabufheaps=1
debug.stagefright.c2inputsurface=-1
media.c2.hal.selection=aidl
media.stagefright.audio.deep=false
vendor.media.omx=0

# Netflix
ro.netflix.bsp_rev=Q8750-39568-1

# Sensors
persist.vendor.sensors.debug.hal=0

# Widevine
vendor.wv.oemcrypto.debug.enable_hlos_data_path=true

# Zygote
zygote.critical_window.minute=10
